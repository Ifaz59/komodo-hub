# ===== Komodo Hub backend environment (example) =====
# Copy this file to ".env" and fill in real values where needed.
#   cp .env.example .env   (or copy on Windows)

# Port the API server listens on
PORT=5000

# Secret used to sign JWT auth tokens (REQUIRED).
# Set this to any long, random string.
JWT_SECRET=change_me_to_a_long_random_secret

# Allowed CORS origin — must match where the React frontend runs.
# Create React App defaults to port 3000.
CLIENT_URL=http://localhost:3000

# ----- Optional integrations (the app runs without real values) -----

# Stripe secret key for donations (test key by default)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here

# SMTP credentials for email (only needed if email features are used)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# NOTE: This project uses a local SQLite database (backend/database.sqlite),
# created and seeded automatically on first run — no external DB setup needed.
# DATABASE_URL is unused by the current SQLite config and kept only for reference.
DATABASE_URL=postgresql://postgres:password@localhost:5432/komodo_hub
